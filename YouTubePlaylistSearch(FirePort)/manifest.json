{
  "manifest_version": 2,
  "name": "YouTube Playlist Search",
  "version": "1.0.3",
  "description": "Goodbye to manually searching through multiple videos in a large playlist",
  "permissions": [
    "activeTab",
    "*://*.youtube.com/*"
  ],
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content/content.js"],
      "css": ["styles/styles.css"]
    }
  ],
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "youtube-playlist-search@example.com",
      "data_collection_permissions": {
        "required": ["none"]
      },
      "strict_min_version": "58.0"
    }
  }
} 